{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile and subscription state in DEVAN platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "registrationDate": { "type": "string" },
        "accountStatus": {
          "type": "string",
          "enum": ["PENDING", "ACTIVE", "EXPIRED", "SUSPENDED"]
        },
        "activationDate": { "type": "string" },
        "expirationDate": { "type": "string" },
        "subscriptionType": {
          "type": "string",
          "enum": ["WEEKLY", "MONTHLY", "YEARLY", "NONE"]
        },
        "emailVerified": { "type": "boolean" }
      },
      "required": ["uid", "fullName", "email", "phone", "accountStatus"]
    },
    "ActivationRequest": {
      "title": "ActivationRequest",
      "description": "User activation request submitted to administrator",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "requestDate": { "type": "string" },
        "requestStatus": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "telegramRequestStatus": {
          "type": "string",
          "enum": ["PENDING", "SENT"]
        }
      },
      "required": ["requestId", "userId", "fullName", "email", "phone", "requestStatus"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Subscription record and history",
      "type": "object",
      "properties": {
        "subscriptionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "plan": {
          "type": "string",
          "enum": ["WEEKLY", "MONTHLY", "YEARLY"]
        },
        "startDate": { "type": "string" },
        "expirationDate": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "EXPIRED", "CANCELLED"]
        }
      },
      "required": ["subscriptionId", "userId", "plan", "startDate", "expirationDate", "status"]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Audit trail log of administrator actions",
      "type": "object",
      "properties": {
        "logId": { "type": "string", "maxLength": 128 },
        "adminId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 200 },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string" }
      },
      "required": ["adminId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles indexed by UID"
    },
    "/activation_requests/{requestId}": {
      "schema": { "$ref": "#/entities/ActivationRequest" },
      "description": "User activation requests"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Subscription records"
    },
    "/admin_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminLog" },
      "description": "Security audit logs for admin actions"
    }
  }
}
